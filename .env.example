# ── Claude Code ──
CLAUDE_BIN=claude
CLAUDE_PROJECT_DIR=/Users/johnny/edict
CLAUDE_MAX_TURNS=10
# Restrict tools per agent; empty = all allowed
CLAUDE_ALLOWED_TOOLS=Bash,Read,Write,Edit,Glob,Grep

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Postgres ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=edict
POSTGRES_USER=edict
POSTGRES_PASSWORD=YOUR_PASSWORD_HERE

# ── Server ──
PORT=8000
DEBUG=true
